{
  "manifest_version": 3,
  "name": "TabFit",
  "version": "0.4.0",
  "description": "Describe your task. Jev helps keep your browsing on track during a focus session.",
  "minimum_chrome_version": "125",
  "incognito": "not_allowed",
  "permissions": ["storage", "alarms", "scripting", "webNavigation", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "TabFit", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'; connect-src 'self' http: https:"
  }
}
